# Copy this file to `.env` or use `php_app/config.local.php` for local overrides.
# Never commit real secrets to Git.

UTHENGA_ENV=production
UTHENGA_BASE_URL=https://your-domain.com/

DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=
DB_NAME=uthenga_db
DB_USER=uthenga_user
DB_PASS=your_db_password

# Optional legacy aliases supported by config.php
UTHENGA_DB_HOST=localhost
UTHENGA_DB_PORT=3306
UTHENGA_DB_SOCKET=
UTHENGA_DB_NAME=uthenga_db
UTHENGA_DB_USER=uthenga_user
UTHENGA_DB_PASS=your_db_password

UTHENGA_SUPPORT_EMAIL=support@your-domain.com
UTHENGA_MAIL_FROM_EMAIL=support@your-domain.com
UTHENGA_MAIL_FROM_NAME=Uthenga
UTHENGA_PASSWORD_RESET_TTL_MINUTES=60

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Travel Intelligence Engine (disabled until its Phase 2 staging checks pass)
TIE_ENABLED=false
TIE_SERVICE_NAME=travel-intelligence-engine
TIE_API_VERSION=v1
TIE_QUERY_ENABLED=false
TIE_AVAILABILITY_ENABLED=false
# 0 means no declared-inventory freshness policy has been approved yet.
TIE_AVAILABILITY_MAX_AGE_SECONDS=0
TIE_CONTEXT_ENABLED=false
TIE_CONTEXT_USER_CACHE_SECONDS=60
TIE_LOCATION_ENABLED=false
TIE_LOCATION_FRESH_SECONDS=300
TIE_LOCATION_AGING_SECONDS=900
TIE_LOCATION_EXPIRED_SECONDS=3600
# Phase 6.5 accuracy classes. Thresholds must ascend from excellent to poor.
TIE_LOCATION_ACCURACY_EXCELLENT_MAX_METERS=25
TIE_LOCATION_ACCURACY_GOOD_MAX_METERS=1000
TIE_LOCATION_ACCURACY_MODERATE_MAX_METERS=5000
TIE_LOCATION_ACCURACY_POOR_MAX_METERS=20000
# Maximum accepted future capture-time skew during validation.
TIE_LOCATION_CLOCK_SKEW_SECONDS=300
# Deprecated compatibility setting; GOOD is the nearby-search maximum by default.
TIE_LOCATION_NEARBY_MAX_ACCURACY_METERS=1000
# Phase 6.7 deterministic confidence policy.
TIE_LOCATION_CONFIDENCE_POLICY_VERSION=v1
TIE_LOCATION_CONFIDENCE_HIGH_SOURCES=browser_geolocation,device_gps
TIE_LOCATION_CONFIDENCE_MEDIUM_SOURCES=browser_geolocation,device_gps,manual_location,saved_location,vendor_location,geocoded_address
TIE_LOCATION_CONFIDENCE_HIGH_ACCURACY=EXCELLENT,GOOD
TIE_LOCATION_CONFIDENCE_HIGH_FRESHNESS=FRESH
TIE_LOCATION_CONFIDENCE_MEDIUM_ACCURACY=EXCELLENT,GOOD,MODERATE
TIE_LOCATION_CONFIDENCE_MEDIUM_FRESHNESS=FRESH,AGING
TIE_LOCATION_CONFIDENCE_INCOMPLETE=UNKNOWN
TIE_LOCATION_CONFIDENCE_NEARBY_SEARCH_MINIMUM=MEDIUM
TIE_LOCATION_CONFIDENCE_TRIP_PLANNING_MINIMUM=LOW
TIE_LOCATION_CONFIDENCE_REGIONAL_CONTEXT_MINIMUM=LOW
TIE_LOCATION_CONFIDENCE_ROUTING_MINIMUM=HIGH
TIE_LOCATION_CONFIDENCE_LIVE_JOURNEY_TRACKING_MINIMUM=HIGH
# Phase 6.8 process-local, identity-free geographic-context cache. 0 disables it.
TIE_GEOGRAPHIC_CONTEXT_CACHE_SECONDS=0
TIE_GEOGRAPHIC_CONTEXT_CACHE_MAX_ENTRIES=1000
TIE_LOCATION_CONTEXT_RATE_LIMIT=20
TIE_LOCATION_NEARBY_RATE_LIMIT=10
TIE_LOCATION_PERMISSION_RATE_LIMIT=20
TIE_LOCATION_VENDOR_COORDINATE_RATE_LIMIT=10
TIE_LOCATION_VENDOR_COORDINATE_REVIEW_RATE_LIMIT=10
TIE_LOCATION_VENDOR_COORDINATE_IMPORT_RATE_LIMIT=10
TIE_VENDOR_LOCATION_STALE_DAYS=365
TIE_VENDOR_COORDINATE_IMPORT_MAX_ENTRIES=100
# Reverse geocoding is opt-in because it sends coordinates to a third party.
TIE_GEOCODER_ENABLED=false
TIE_GEOCODER_PROVIDER=
TIE_GEOCODER_FALLBACK_PROVIDERS=
TIE_GEOCODER_TIMEOUT_SECONDS=5
TIE_GEOCODER_RETRY_ATTEMPTS=0
TIE_GEOCODER_RATE_LIMIT_PER_MINUTE=10
TIE_NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
TIE_TRIP_PLANNER_ENABLED=false
TIE_RECOMMENDATIONS_ENABLED=false
TIE_PLANS_ENABLED=false
TIE_PLAN_RATE_LIMIT=10
TIE_PLAN_MAX_DAILY_ACTIVITIES=3
TIE_PLAN_MIN_CONNECTION_MINUTES=30
TIE_BOOKING_ENABLED=false
TIE_BOOKING_VERSION=booking-orchestration/v1
TIE_BOOKING_TIMEOUT=20
TIE_BOOKING_RETRY_LIMIT=0
TIE_BOOKING_ROLLBACK_POLICY=manual_review
TIE_BOOKING_REQUIRE_REVALIDATION=true
TIE_BOOKING_MAX_CONCURRENT=1
TIE_BOOKING_IDEMPOTENCY_WINDOW=86400
# The deployed legacy booking route marks payment paid immediately. Keep false
# until that gateway/payment policy is explicitly approved for TIE execution.
TIE_BOOKING_LEGACY_IMMEDIATE_CAPTURE_ENABLED=false
TIE_BOOKING_RATE_LIMIT=5
# Phases 15/16: payment intents stay disabled until a real atomic inventory-hold
# provider and safe booking-commit provider are deployed. Do not reuse a public
# key as a server secret or an API key as a webhook secret.
TIE_PAYMENT_ENABLED=false
TIE_PAYMENT_COMMIT_ENABLED=false
TIE_PAYMENT_RATE_LIMIT=5
TIE_PAYCHANGU_ENABLED=false
TIE_PAYCHANGU_SECRET_KEY=
TIE_PAYCHANGU_WEBHOOK_SECRET=
TIE_PAYCHANGU_API_BASE_URL=https://api.paychangu.com
TIE_PAYCHANGU_WEBHOOK_URL=
TIE_PAYCHANGU_RETURN_URL=
TIE_PAYCHANGU_TIMEOUT=20
TIE_RECOMMENDATION_VERSION=deterministic-ranking/v1
TIE_RECOMMENDATION_RATE_LIMIT=10
TIE_RECOMMENDATION_DISTANCE_WEIGHT=20
TIE_RECOMMENDATION_AVAILABILITY_WEIGHT=20
TIE_RECOMMENDATION_PRICE_WEIGHT=15
TIE_RECOMMENDATION_CATEGORY_WEIGHT=15
TIE_RECOMMENDATION_DATE_WEIGHT=10
TIE_RECOMMENDATION_VENDOR_WEIGHT=10
TIE_RECOMMENDATION_CONTEXT_WEIGHT=10
TIE_RECOMMENDATION_DISTANCE_REFERENCE_KM=50
TIE_RECOMMENDATION_PRICE_REFERENCE=100000
TIE_LOCATION_ENABLED=false
TIE_ROUTING_ENABLED=false
TIE_LLM_ENABLED=false
TIE_AI_ENABLED=false
TIE_JOURNEY_ENABLED=false
TIE_NOTIFICATIONS_ENABLED=false
# Delivery workers are safe to overlap because they use database leases.
TIE_NOTIFICATION_MAX_ATTEMPTS=5
TIE_NOTIFICATION_BACKOFF_SECONDS=60
TIE_NOTIFICATION_LEASE_SECONDS=120
# PHP mail only proves local mail-transport handoff, never final delivery.
TIE_NOTIFICATION_EMAIL_ENABLED=false
TIE_NOTIFICATION_EMAIL_PROVIDER=php_mail
# Generic SMS adapter. Require HTTPS and keep the bearer token in secret storage.
TIE_NOTIFICATION_SMS_ENABLED=false
TIE_NOTIFICATION_SMS_PROVIDER=generic_http
TIE_NOTIFICATION_SMS_ENDPOINT=
TIE_NOTIFICATION_SMS_BEARER_TOKEN=
TIE_NOTIFICATION_SMS_SENDER=
TIE_NOTIFICATION_SMS_TIMEOUT=10
TIE_QUICK_TRAVEL_ENABLED=false
TIE_VENDOR_PROFILES_ENABLED=false
# Phase 11 coordination. A Quick Travel request requires explicit foreground
# device location; this does not affect ordinary marketplace browsing.
TIE_COORDINATION_REQUEST_SECONDS=600
TIE_COORDINATION_ACCEPTED_SECONDS=900
TIE_COORDINATION_LOCATION_MAX_SECONDS=7200
TIE_COORDINATION_ACTION_RATE_LIMIT=40
# Conversation is disabled unless both TIE_LLM_ENABLED and TIE_AI_ENABLED are true.
# Use mock for local tests only. Live provider credentials belong in a local secret store.
TIE_AI_PROVIDER=
TIE_AI_MODEL=
# Local secret only; never commit a live API key.
TIE_OPENAI_API_KEY=
# Local secret only; Groq's production default is openai/gpt-oss-20b.
TIE_GROQ_API_KEY=
TIE_AI_TIMEOUT=15
TIE_AI_MAX_TOKENS=800
TIE_AI_TEMPERATURE=0
TIE_AI_MAX_HISTORY=8
TIE_AI_MEMORY_SECONDS=1800
TIE_AI_PROMPT_VERSION=ai-conversation-prompt/v1
TIE_AI_TOOL_MODE=server_orchestrated
TIE_AI_CHAT_RATE_LIMIT=10
# FastAPI internal tool boundary. Generate two unrelated secrets (32+ chars).
# TIE_AI_CAPABILITY_SECRET stays in PHP only; do not copy it to FastAPI.
TIE_AI_TOOL_TOKEN=
TIE_AI_CAPABILITY_SECRET=
# Optional FastAPI conversation bridge. Keep the service token out of React.
TIE_FASTAPI_AI_ENABLED=false
TIE_FASTAPI_URL=http://127.0.0.1:8001/v1/conversation
TIE_FASTAPI_SERVICE_TOKEN=
TIE_FASTAPI_TIMEOUT=15
# Reserve generic provider settings here; do not add provider secrets to source control.
TIE_LLM_PROVIDER=
TIE_LLM_MODEL=
TIE_PROVIDER_TIMEOUT_SECONDS=15
