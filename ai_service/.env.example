# Internal service only. Never put provider keys in the React application.
UTHENGA_AI_SERVICE_TOKEN=replace-with-a-long-random-internal-token
UTHENGA_PHP_TOOL_URL=http://127.0.0.1/uthenga/api/tie/ai/tools.php
UTHENGA_PHP_TOOL_TOKEN=replace-with-a-separate-long-random-token
# Must match PHP's TIE_AI_TOOL_TOKEN. PHP keeps TIE_AI_CAPABILITY_SECRET private.
UTHENGA_AI_PROVIDER=disabled
# Set to groq only after creating GROQ_API_KEY in the service environment.
GROQ_API_KEY=
UTHENGA_AI_MODEL=openai/gpt-oss-20b
UTHENGA_AI_TIMEOUT_SECONDS=12
